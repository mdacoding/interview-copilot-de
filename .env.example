# DE AI Interview Copilot - Environment Variables
# Frontend: .env in project root (VITE_*)
# Backend: backend/.env

# ---------- OpenAI (Backend) ----------
OPENAI_API_KEY=sk-your-openai-api-key

# ---------- Supabase Auth ----------
# Project URL + anon key from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# JWT Secret (Backend): Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
# Supabase Service Key (for admin operations like updating user profiles)
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# ---------- Stripe (Backend, PCI-DSS compliant) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...      # $29/month (Subscription)
STRIPE_PRICE_ID_LIFETIME=price_...  # $299 one-time (Product Hunt)
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- API URL (Frontend) ----------
VITE_API_URL=https://your-backend-url.com

# ---------- Optional ----------
MOCK_MODE=0
